---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="500: Server Error - Typing Exam Practice">
    <div class="flex flex-col items-center justify-center min-h-[50vh] text-center px-4 py-8 sm:py-12 max-w-lg mx-auto w-full">
        <h1 class="text-7xl sm:text-8xl md:text-9xl font-extrabold text-accent-orange leading-none m-0">500</h1>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold my-3 sm:my-4 text-ink">Server Error</h2>
        <p class="text-ink-secondary text-sm sm:text-base max-w-md mb-6 sm:mb-8 leading-relaxed">
            Something went wrong on our end. We're working on fixing the issue. Please try again later.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto justify-center">
            <button onclick="window.location.reload()" class="cursor-pointer inline-flex items-center justify-center gap-2 bg-white text-ink border border-hairline hover:bg-canvas-soft px-6 py-3 rounded-full font-medium text-sm sm:text-base transition-colors shadow-xs">
                <i class="fas fa-redo"></i> Try Again
            </button>
            <a href="/" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-active text-white px-6 py-3 rounded-full font-semibold text-sm sm:text-base transition-colors shadow-xs">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>
</MainLayout>
