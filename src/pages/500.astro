---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="500: Server Error - Typing Exam Practice">
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 50vh; text-align: center; padding: 2rem;">
        <h1 style="font-size: 120px; font-weight: 800; color: var(--color-accent-orange); line-height: 1; margin: 0;">500</h1>
        <h2 style="font-size: 32px; font-weight: 700; margin: 16px 0; color: var(--color-ink);">Server Error</h2>
        <p style="color: var(--color-ink-secondary); font-size: 18px; max-width: 500px; margin-bottom: 32px; line-height: 1.6;">
            Something went wrong on our end. We're working on fixing the issue. Please try again later.
        </p>
        <div style="display: flex; gap: 16px;">
            <button onclick="window.location.reload()" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; background-color: white; color: var(--color-ink); border: 1px solid var(--color-hairline); padding: 12px 28px; border-radius: 9999px; font-weight: 500; cursor: pointer; transition: background-color 0.2s;">
                <i class="fas fa-redo"></i> Try Again
            </button>
            <a href="/" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; background-color: var(--color-primary); color: white; padding: 12px 28px; border-radius: 9999px; font-weight: 600; text-decoration: none; transition: background-color 0.2s;">
                <i class="fas fa-home"></i> Back to Home
            </a>
        </div>
    </div>
</MainLayout>
