---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="404: Page Not Found - Typing Exam Practice">
    <div class="flex flex-col items-center justify-center min-h-[50vh] text-center px-4 py-8 sm:py-12 max-w-lg mx-auto w-full">
        <h1 class="text-7xl sm:text-8xl md:text-9xl font-extrabold text-primary leading-none m-0">404</h1>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold my-3 sm:my-4 text-ink">Oops! Page not found</h2>
        <p class="text-ink-secondary text-sm sm:text-base max-w-md mb-6 sm:mb-8 leading-relaxed">
            Looks like your fingers slipped! The page you are looking for doesn't exist or has been moved.
        </p>
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-active text-white px-6 sm:px-7 py-3 rounded-full font-semibold text-sm sm:text-base transition-colors shadow-xs">
            <i class="fas fa-home"></i> Back to Home
        </a>
    </div>
</MainLayout>
