---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us - Typing Exam Practice">
    <div class="container max-w-xl mt-2 sm:mt-6 w-full">
        <div class="text-center mb-6 sm:mb-8">
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-primary/10 text-primary inline-flex items-center justify-center text-xl sm:text-2xl mb-3 sm:mb-4">
                <i class="fas fa-envelope"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold mb-2">Contact Us</h1>
            <p class="text-ink-muted text-sm sm:text-base max-w-md mx-auto leading-relaxed">
                Have questions, feedback, or found a bug? We'd love to hear from you.
            </p>
        </div>

        <div class="bg-canvas-soft border border-hairline rounded-xl sm:rounded-2xl p-5 sm:p-8 text-center flex flex-col items-center gap-3 sm:gap-4">
            <p class="text-ink-secondary text-sm sm:text-base m-0 leading-relaxed">
                You can reach us directly via email at:
            </p>

            <a
                href="mailto:support@typingexampractice.com"
                class="text-base sm:text-lg font-semibold text-primary hover:underline break-all"
            >
                support@typingexampractice.com
            </a>

            <a
                href="mailto:support@typingexampractice.com"
                class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-active text-white px-5 sm:px-6 py-2.5 rounded-full font-medium text-sm transition-colors mt-2"
            >
                <i class="fas fa-paper-plane text-xs"></i>
                <span>Send an Email</span>
            </a>
        </div>

        <div class="mt-5 sm:mt-6 text-center">
            <p class="text-ink-muted text-xs sm:text-sm m-0">
                We typically respond within 24-48 business hours.
            </p>
        </div>
    </div>
</MainLayout>
